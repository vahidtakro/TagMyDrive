# TagMyDrive Environment Variables
# Copy this file to .env and fill in your values.
# Desktop app reads these; app.config is used as fallback if env vars are unset.

# ── Database ────────────────────────────────────────────────────────────────
# Full MySQL connection string
TAGMYDRIVE_DB_CONNECTION=Server=your-host;Port=3306;Database=your_db;Uid=your_user;Pwd=your_password;SslMode=Required;ConnectionTimeout=30;

# ── Google Drive OAuth ─────────────────────────────────────────────────────
# Create at https://console.cloud.google.com > Credentials > OAuth client ID
# Application type: "Desktop app"
TAGMYDRIVE_GOOGLE_CLIENT_ID=
TAGMYDRIVE_GOOGLE_CLIENT_SECRET=

# ── Crypto Payments (USDT BEP20) ──────────────────────────────────────────
# Your BEP20 wallet address to receive payments
TAGMYDRIVE_CRYPTO_WALLET_USDT=

# Free API key from https://bscscan.com/myapikey
TAGMYDRIVE_BSCSCAN_API_KEY=

# ── Unsplash (Web App - optional) ──────────────────────────────────────────
# Free API key from https://unsplash.com/developers (for disk image search)
# Without this, the image search feature is disabled but URL input still works.
UNSPLASH_ACCESS_KEY=
